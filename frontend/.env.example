# ─── Site TogoMobile — exemple de configuration (aucune valeur réelle) ───────
# Copier en .env.local pour le développement.

# URL de l'API, utilisée par le serveur Next.js et par le relais /api/v1 (lue au moment du build).
API_URL=http://localhost:4000
# URL publique du site (balises canoniques, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Application d'administration (dossier admin/, déployée séparément).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Nom du cookie de session (doit correspondre à SESSION_COOKIE_NAME de l'API).
SESSION_COOKIE_NAME=tm_session

# Informations publiques facultatives (n'afficher que ce qui existe réellement).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# Photos facultatives (fichiers placés dans frontend/public, ex. /images/accueil.jpg).
# Sans photo, l'accueil et les bandeaux utilisent un aplat bleu nuit. Utiliser des photos réelles.
NEXT_PUBLIC_HERO_IMAGE=
NEXT_PUBLIC_BANNER_IMAGE=
# WhatsApp officiel de la plateforme (support) : affiche le bouton vert dans l'en-tête s'il est renseigné.
NEXT_PUBLIC_PLATFORM_WHATSAPP=

# Cache des pages publiques, invalidé par l'API (même valeur que REVALIDATE_SECRET côté API).
# Vide : cache d'une seconde seulement (pas d'invalidation).
REVALIDATE_SECRET=
# Durée maximale de cache en cas d'invalidation manquée (secondes).
CACHE_MAX_SECONDS=300
