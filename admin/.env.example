# ─── Administration TogoMobile — exemple de configuration (aucune valeur réelle) ───
# Copier en .env.local pour le développement. Sur Vercel : projet distinct, Root Directory « admin ».

# URL de l'API (relais /api/v1/*). Définie AVANT le build.
API_URL=http://localhost:4000
# Site public (liens « Voir le site », fiches produit, mot de passe oublié).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Doit être identique à SESSION_COOKIE_NAME de l'API.
SESSION_COOKIE_NAME=tm_session
