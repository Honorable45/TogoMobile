# TogoMobile — backend — préproduction — MODÈLE SANS SECRET
# Généré par : node scripts/prepare-env.mjs --examples. Pour de vrais fichiers : --env staging --domain <domaine>.

# ─── API + worker (Render) — à saisir dans le groupe de variables « togomobile-shared » ───
# Le service web et le worker utilisent les mêmes valeurs. PORT est fourni par Render.
# Toujours « production » sur Render, y compris en préproduction.
NODE_ENV=production
# À RENSEIGNER — Render → la base PostgreSQL → Connect → « Internal Database URL » (même région que l’API), puis ajouter ?connection_limit=10 à la fin. URL externe (Neon, Supabase…) : ?sslmode=require&connection_limit=10.
DATABASE_URL=
# HMAC des numéros d’acheteurs. NE JAMAIS LE CHANGER une fois en production.
APP_SECRET="<généré par scripts/prepare-env.mjs>"

# ─── Adresses ───
WEB_URL="https://staging.<domaine>"
API_URL="https://api-staging.<domaine>"
# Origine autorisée de l’application d’administration.
ADMIN_URL="https://admin-staging.<domaine>"
CORS_ORIGINS="https://staging.<domaine>"

# ─── Session ───
# Identique dans le frontend et l’admin.
SESSION_COOKIE_NAME=tm_session
SESSION_COOKIE_SAMESITE=lax
# Laisser vide : sessions du site et de l’admin séparées.
SESSION_COOKIE_DOMAIN=
SESSION_DAYS=30
# Vercel puis Render. À vérifier avec GET /api/v1/admin/debug/client-ip.
TRUST_PROXY_HOPS=2

# ─── Stockage des médias (Cloudinary) ───
STORAGE_DRIVER=cloudinary
# À RENSEIGNER — cloudinary.com → Settings → API Keys : variable « CLOUDINARY_URL » au format cloudinary://<api_key>:<api_secret>@<cloud_name> (bouton « Copy »).
CLOUDINARY_URL=
# Dossier racine des médias dans le compte (sépare production et préproduction).
CLOUDINARY_FOLDER=togomobile-staging
MEDIA_MAX_IMAGE_MB=8
MEDIA_MAX_VIDEO_MB=40
MEDIA_MAX_VIDEO_SECONDS=90
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_PROCESSING=queue
MEDIA_TRANSCODE_VIDEO=true
# Vide : binaire du paquet ffmpeg-static.
FFMPEG_PATH=

# ─── Worker et montée en charge ───
# Le worker est un service Render séparé.
WORKER_IN_PROCESS=false
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000
# Processus par instance ; au-delà de 1, renseigner REDIS_URL.
WEB_CONCURRENCY=1
# Facultatif ; obligatoire dès plusieurs instances ou processus. Render → Key Value → Connect → « Internal Key Value URL ».
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120
PAGINATION_MAX_OFFSET=5000

# ─── Cache ───
PUBLIC_CACHE_SECONDS=30
WEB_REVALIDATE_URL="https://staging.<domaine>/api/revalidate"
# Identique dans le frontend.
REVALIDATE_SECRET="<généré, identique API/frontend>"

# ─── Observabilité ───
# Jeton Bearer de /api/v1/metrics (collecte Prometheus).
METRICS_TOKEN="<généré>"
SLOW_QUERY_MS=500
SLOW_REQUEST_MS=1500

# ─── Sécurité ───
LOGIN_MAX_FAILURES=8
LOGIN_LOCK_MINUTES=15
SWAGGER_ENABLED=true

# ─── E-mails (Resend) ───
MAIL_DRIVER=resend
# Le domaine d’envoi doit être vérifié dans Resend (Domains → Add Domain, puis enregistrements DNS).
MAIL_FROM="TogoMobile <no-reply@<domaine>>"
# À RENSEIGNER — resend.com → API Keys → Create API Key → permission « Sending access » (commence par re_).
RESEND_API_KEY=

# ─── Règles anti-abus ───
RULE_MAX_SALES_PER_DAY=30
RULE_MAX_SALES_PER_DAY_NEW_SHOP=5
RULE_REVIEW_TOKEN_DAYS=60
RULE_REFERENCE_PRICE_DAYS=30
RULE_MAX_PROMOTION_DAYS=90
# Jamais « true » en production.
ALLOW_DEMO_SEED=false
