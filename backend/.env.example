# ─── API TogoMobile — exemple de configuration (aucune valeur réelle) ─────────
# Copier en .env pour le développement. En production, définir ces variables chez l'hébergeur.

NODE_ENV=development
PORT=4000

# PostgreSQL (14+). En production : base managée, connexion chiffrée (?sslmode=require).
DATABASE_URL=postgresql://togomobile:motdepasse@localhost:5432/togomobile?schema=public

# URL publique du site (liens WhatsApp, QR codes, e-mails) et de l'API.
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
# URL de l'application d'administration (dossier admin/). Ajoutée automatiquement aux origines autorisées.
ADMIN_URL=http://localhost:3001
# Origines autorisées (CORS + protection CSRF), séparées par des virgules.
CORS_ORIGINS=http://localhost:3000

# Secret serveur (HMAC des numéros d'acheteur). 32 caractères minimum en production.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=remplacer-par-une-valeur-aleatoire-de-48-caracteres-minimum

# Cookie de session (httpOnly). « lax » avec le relais /api du site (recommandé).
SESSION_COOKIE_NAME=tm_session
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_DAYS=30
# Nombre de proxys de confiance devant l'API (voir docs/DEPLOIEMENT.md, « Adresse IP des clients »).
TRUST_PROXY_HOPS=1

# Stockage des médias : local (développement uniquement), cloudinary, ou s3 (S3, Cloudflare R2, MinIO…).
STORAGE_DRIVER=local
# Cloudinary : cloudinary.com → Settings → API Keys → « CLOUDINARY_URL ».
CLOUDINARY_URL=
# Dossier racine des médias dans le compte Cloudinary (togomobile, togomobile-staging…).
CLOUDINARY_FOLDER=togomobile
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publique du bucket (domaine personnalisé R2 ou CDN), sans / final.
S3_PUBLIC_URL=
MEDIA_MAX_IMAGE_MB=8
MEDIA_MAX_VIDEO_MB=40
MEDIA_MAX_VIDEO_SECONDS=90
# Durée de validité d'une autorisation d'envoi direct (URL présignée), en secondes.
MEDIA_UPLOAD_TTL_SECONDS=900
# queue : traitement par le worker (production) ; inline : dans la requête (dépannage).
MEDIA_PROCESSING=queue
# ffmpeg (durée, miniature, transcodage vidéo). Vide : binaire du paquet ffmpeg-static s'il est présent.
FFMPEG_PATH=
MEDIA_TRANSCODE_VIDEO=true

# ─── Worker (traitements asynchrones) ───
# true : le worker tourne dans le processus de l'API (développement). En production : service séparé.
WORKER_IN_PROCESS=true
WORKER_CONCURRENCY=2
WORKER_POLL_MS=1000

# ─── Montée en charge ───
# Pool PostgreSQL : paramètre connection_limit de DATABASE_URL (ex. ...?connection_limit=10).
# Processus par instance (cluster Node). Avec > 1, définir REDIS_URL.
WEB_CONCURRENCY=1
# Redis facultatif : compteurs de limitation de débit partagés entre processus et instances.
REDIS_URL=
RATE_LIMIT_PER_MINUTE=120
PAGINATION_MAX_OFFSET=5000

# ─── Cache ───
# Cache CDN (s-maxage, secondes) des lectures publiques anonymes de l'API. 0 = désactivé.
PUBLIC_CACHE_SECONDS=0
# Invalidation du cache du site après chaque changement (prix, disponibilité, boutique, promotion).
WEB_REVALIDATE_URL=
REVALIDATE_SECRET=

# ─── Observabilité ───
# Jeton Bearer de /api/v1/metrics (Prometheus). Vide = désactivé.
METRICS_TOKEN=
SLOW_QUERY_MS=500
SLOW_REQUEST_MS=1500

# ─── Sécurité ───
LOGIN_MAX_FAILURES=8
LOGIN_LOCK_MINUTES=15

# E-mails (réinitialisation du mot de passe) : console (développement) ou resend.
MAIL_DRIVER=console
MAIL_FROM=TogoMobile <no-reply@votre-domaine.tg>
RESEND_API_KEY=

# Règles anti-abus (valeurs par défaut).
RULE_MAX_SALES_PER_DAY=30
RULE_MAX_SALES_PER_DAY_NEW_SHOP=5
RULE_REVIEW_TOKEN_DAYS=60
RULE_REFERENCE_PRICE_DAYS=30
RULE_MAX_PROMOTION_DAYS=90

# Données de démonstration (pnpm --filter backend seed:demo) : refusées en production sauf ALLOW_DEMO_SEED=true. Ne jamais l'activer en production.
ALLOW_DEMO_SEED=false
# Documentation Swagger (/api/docs) : toujours active hors production.
SWAGGER_ENABLED=false

# Tests : base dédiée dont le nom finit par _test (par défaut : DATABASE_URL suffixée « _test »).
# TEST_DATABASE_URL=postgresql://togomobile:motdepasse@localhost:5432/togomobile_test
